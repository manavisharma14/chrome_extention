{
  "manifest_version": 3,
  "name": "Reading time",
  "version": "1.0",
  "description": "Add the reading time to the chrome extension documentation articles",

  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "https://developer.chrome.com/docs/extensions/*",
        "https://developer.chrome.com/docs/webstore/*",
        "https://developer.chrome.com/docs/devtools/*",
        "https://*.substack.com/*",
        "https://substack.com/*"
      ]
    }
  ]
}